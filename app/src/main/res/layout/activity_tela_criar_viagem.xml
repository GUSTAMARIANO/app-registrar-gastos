<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background"
    tools:context=".Tela_criar_viagem">

    <View
        android:id="@+id/container_viagem"
        style="@style/container"
        android:layout_height="550dp"
        android:layout_margin="30dp"
        android:layout_marginTop="600dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"

        />

    <EditText
        android:id="@+id/edit_1"
        style="@style/editText"
        android:hint="Título da Viagem"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/container_viagem"
        
        />

    <EditText
        android:id="@+id/edit_2"
        style="@style/editText"
        android:hint="Ponto de Partida"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_1"
        />

    <EditText
        android:id="@+id/edit_3"
        style="@style/editText"
        android:hint="Destino"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_2"
        />

    <EditText
        android:id="@+id/edit_4"
        style="@style/editText"
        android:hint="Data de Inicio"
        android:inputType="datetime"
        android:maxLength="10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_3"
        />

    <EditText
        android:id="@+id/edit_5"
        style="@style/editText"
        android:hint="Data de Encerramento"
        android:inputType="date"
        android:maxLength="10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_4"
        />

    <EditText
        android:id="@+id/edit_6"
        style="@style/editText"
        android:hint="Orçamento"
        android:inputType="numberDecimal"
        android:digits="0123456789.,"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_5"
        />

    <CheckBox
        android:id="@+id/chb_orcamento"
        android:layout_width="162dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="168dp"
        android:text="Sem orçamento fixo"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_6" />

    <EditText
        android:id="@+id/edit_7"
        style="@style/editText"
        android:hint="Passageiros"
        android:inputType="number"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chb_orcamento"
        />

    <androidx.appcompat.widget.AppCompatButton
        style="@style/button"
        android:text="Criar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/container_viagem"
        />






</androidx.constraintlayout.widget.ConstraintLayout>